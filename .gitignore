# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environment (managed by uv)
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets — never commit; see .env.example
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store

# Claude Code local (personal) settings; shared .claude/settings.json is committed
.claude/settings.local.json

# Experiment runs (state, arrays, reports) — generated
runs/

# Scientific papers (copyrighted PDFs) — kept locally, not committed
data/papers/*.pdf
