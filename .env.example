# Copy this file to `.env` and adjust values. `.env` is git-ignored.
# Real environment variables take precedence over values in `.env`.

# --- Application -------------------------------------------------------------------------
# Runtime environment: dev | test
EXPSYS_APP_ENV=dev
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
EXPSYS_LOG_LEVEL=INFO

# --- Orchestrator ------------------------------------------------------------------------
# Max analysis cycles per run (a TaskRequest / CLI flag may override it)
EXPSYS_MAX_ITERATIONS=5
# Max agent LLM calls per run (each call makes <= EXPSYS_LLM_MAX_ATTEMPTS requests);
# exceeding it ends the run as FAILED with a clear error
EXPSYS_MAX_LLM_CALLS=40
# Pause before every execute() and ask for confirmation in the CLI (needed for hardware)
EXPSYS_REQUIRE_APPROVAL=false
# Where run directories are created
EXPSYS_RUNS_DIR=runs

# --- LLM provider: OpenRouter (OpenAI-compatible API) ------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model ids are configured ONLY here (never in code). DEFAULT_MODEL is used by every agent
# whose own variable is empty. Examples: openai/gpt-4o-mini, anthropic/claude-sonnet-4.5
DEFAULT_MODEL=
SCIENTIST_MODEL=
EXPERIMENT_MODEL=
RUNNER_MODEL=
ANALYST_MODEL=
# Structured output: auto (json_schema, fall back to JSON-in-text) | json_schema | text
EXPSYS_LLM_STRUCTURED_MODE=auto
EXPSYS_LLM_MAX_ATTEMPTS=3
EXPSYS_LLM_TIMEOUT_S=120
EXPSYS_LLM_TEMPERATURE=0.2

# --- Knowledge Base: Pinecone (integrated embedding) -------------------------------------
PINECONE_API_KEY=
# Index name and embedding model are configured only here, e.g. llama-text-embed-v2
PINECONE_INDEX=
PINECONE_EMBED_MODEL=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=papers

# --- Tests -------------------------------------------------------------------------------
# Live tests (@pytest.mark.live) call OpenRouter / Pinecone and cost money; they run only
# when this is 1 AND the corresponding keys are set.
EXPSYS_RUN_LIVE=0
